# Copy to `.env` and fill in. Everything the app needs to talk to a backend.
# EXPO_PUBLIC_* is inlined into the bundle at build time, so only ever put
# publishable values here — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Cloud console → Credentials → OAuth 2.0 Client IDs.
# Web client: also paste its ID and secret into Supabase → Auth → Providers → Google.
# iOS client: its reversed form goes in app.json under the google-signin plugin's
# `iosUrlScheme`, and its bundle ID must match `ios.bundleIdentifier`.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional. Restricts the Google account picker to one Workspace domain.
# The signup trigger is the real enforcement, so leaving this blank is safe.
EXPO_PUBLIC_GOOGLE_HOSTED_DOMAIN=
