# Copy to .env. EXPO_PUBLIC_* values ship in the app; never include service secrets.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Configure both IDs in Supabase and the reversed iOS ID in app.json.
# Store GOOGLE_PLACES_KEY and OAuth client secrets server-side.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional; Sentry is disabled in development.
EXPO_PUBLIC_SENTRY_DSN=
# Enable only after configuring the Apple provider and iOS entitlement.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
