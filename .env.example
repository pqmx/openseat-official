# Copy to `.env` and fill in. Everything the app needs to talk to a backend.
# EXPO_PUBLIC_* is inlined into the bundle at build time, so only ever put
# publishable values here — never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Create's location field searches Google Places, but its key is NOT here and must
# not be: everything in this file ships inside the bundle. It's a Supabase secret,
# `GOOGLE_PLACES_KEY`, read only by the `places-search` edge function.

# Google Sign-In. Both are OAuth client IDs, which are public by design — the web
# client's *secret* is not here, it goes in Supabase → Auth → Providers → Google.
# The iOS one is also needed as `iosUrlScheme` in app.json, reversed.
# Apple also needs provider credentials in Supabase and the iOS entitlement.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# No hosted-domain variable. `GoogleSignin`'s `hostedDomain` takes one domain and
# UCLA has two, so the rule stays where it always was: `handle_new_user()`.

# Crash reporting. Safe to inline like everything else here — a DSN is an endpoint
# that accepts events and reads nothing back. Leave it empty and Sentry never
# starts, which is what development and a fresh checkout want; `app/_layout.tsx`
# also keeps it off in `__DEV__` regardless.
EXPO_PUBLIC_SENTRY_DSN=
# Set true only after enabling and configuring Apple in Supabase Auth.
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
