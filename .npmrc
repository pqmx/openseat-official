# Expo SDK 57 ships a peer mismatch of its own: expo-router pulls vaul/radix,
# which pull react-dom@19.2.8, which wants react@^19.2.8 — but Expo pins
# react@19.2.3. Both are web-only, and this app is native, so the tree works.
# Without this, `npm install` of anything at all fails with ERESOLVE.
legacy-peer-deps=true
